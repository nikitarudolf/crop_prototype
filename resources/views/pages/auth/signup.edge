@layout({ title: 'Регистрация' })
  <div class="form-page">
    <div class="page-header">
      <h1>Регистрация</h1>
    </div>

    @form({ route: 'new_account.store', method: 'POST' })
      <div class="form-stack">
        @field.root({ name: 'fullName' })
          @!field.label({ text: 'Полное имя' })
          @!input.control()
          @!field.error()
        @end

        @field.root({ name: 'email' })
          @!field.label({ text: 'Электронная почта' })
          @!input.control({ type: 'email', autocomplete: 'email' })
          @!field.error()
        @end

        @field.root({ name: 'password' })
          @!field.label({ text: 'Пароль' })
          @!input.control({ type: 'password', autocomplete: 'new-password' })
          @!field.error()
        @end

        @field.root({ name: 'passwordConfirmation' })
          @!field.label({ text: 'Подтвердите пароль' })
          @!input.control({ type: 'password', autocomplete: 'new-password' })
          @!field.error()
        @end

        <div class="actions">
          @!button({ text: 'Зарегистрироваться', type: 'submit' })
        </div>
      </div>
    @end
  </div>
@end
