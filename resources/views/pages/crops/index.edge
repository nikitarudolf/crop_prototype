@layout({ title: 'Культуры' })
  <div class="page-header">
    <h1>Культуры</h1>
    @!link({ route: 'crops.create', text: 'Добавить культуру', variant: 'primary' })
  </div>

  @if(crops.length)
    <div class="table-wrap">
      <table class="data">
        <thead>
          <tr>
            <th>ID</th>
            <th>Название</th>
            <th>Цена семян, ₽/га</th>
            <th>Урожайность, т/га</th>
            <th>Действия</th>
          </tr>
        </thead>
        <tbody>
          @each(crop in crops)
            <tr>
              <td>{{ crop.id }}</td>
              <td>{{ crop.name }}</td>
              <td>{{ crop.price }}</td>
              <td>{{ crop.avgYieldPerHa }}</td>
              <td>
                <div class="row-actions">
                  @!link({ route: 'crops.show', routeParams: { id: crop.id }, text: 'Открыть' })
                  @!link({ route: 'crops.edit', routeParams: { id: crop.id }, text: 'Изменить' })
                </div>
              </td>
            </tr>
          @end
        </tbody>
      </table>
    </div>
  @else
    <p class="empty">Культур пока нет.</p>
  @end
@end
