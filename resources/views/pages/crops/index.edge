@layout()
  <h1>Культуры</h1>

  <div style="margin: 16px 0;">
    @!link({ route: 'crops.create', text: 'Добавить культуру' })
  </div>

  @if(crops.length)
    <table style="width: 100%; border-collapse: collapse;">
      <thead>
        <tr>
          <th style="text-align: left; padding: 8px 0; border-bottom: 1px solid #e5e5e5;">ID</th>
          <th style="text-align: left; padding: 8px 0; border-bottom: 1px solid #e5e5e5;">Название</th>
          <th style="text-align: left; padding: 8px 0; border-bottom: 1px solid #e5e5e5;">Цена</th>
          <th style="text-align: left; padding: 8px 0; border-bottom: 1px solid #e5e5e5;">Средний урожай на га</th>
          <th style="text-align: left; padding: 8px 0; border-bottom: 1px solid #e5e5e5;">Действия</th>
        </tr>
      </thead>
      <tbody>
        @each(crop in crops)
          <tr>
            <td style="padding: 10px 0; border-bottom: 1px solid #f0f0f0;">{{ crop.id }}</td>
            <td style="padding: 10px 0; border-bottom: 1px solid #f0f0f0;">{{ crop.name }}</td>
            <td style="padding: 10px 0; border-bottom: 1px solid #f0f0f0;">{{ crop.price }}</td>
            <td style="padding: 10px 0; border-bottom: 1px solid #f0f0f0;">{{ crop.avgYieldPerHa }}</td>
            <td>
              @!link({ route: 'crops.show', routeParams: { id: crop.id }, text: 'Открыть' })
              @!link({ route: 'crops.edit', routeParams: { id: crop.id }, text: 'Редактировать' })
            </td>
          </tr>
        @end
      </tbody>
    </table>
  @else
    <p>Культур пока нет.</p>
  @end
@end
