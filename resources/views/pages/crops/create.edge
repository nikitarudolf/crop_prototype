@layout({ title: 'Добавить культуру' })
  <div class="form-page">
    <div class="page-header">
      <h1>Добавить культуру</h1>
    </div>
    @form({ route: 'crops.store', method: 'POST' })
      <div class="form-stack">
        @field.root({ name: 'name' })
          @!field.label({ text: 'Название' })
          @!input.control()
          @!field.error()
        @end
        @field.root({ name: 'family' })
          @!field.label({ text: 'Семейство' })
          @!select.control({
            options: cropFamilies.map((f) => ({
              value: f,
              name: cropFamilyLabel(f),
            })),
          })
          @!field.error()
        @end
        @field.root({ name: 'price' })
          @!field.label({ text: 'Цена семян (Br/га)' })
          @!input.control({ type: 'number', step: '0.01', min: '0.01' })
          @!field.error()
        @end
        @field.root({ name: 'avgYieldPerHa' })
          @!field.label({ text: 'Средняя урожайность (т/га)' })
          @!input.control({ type: 'number', step: '0.01', min: '0.01' })
          @!field.error()
        @end

        <div class="actions">
          @!button({ text: 'Создать', type: 'submit' })
          @!link({ route: 'crops.index', text: 'Отмена', variant: 'secondary' })
        </div>
      </div>
    @end
  </div>
@end
