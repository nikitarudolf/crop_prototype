@layout()
  <h1>{{ fertilizer.name }}</h1>

  <div style="margin: 16px 0;">
    <dl style="display: grid; grid-template-columns: 220px 1fr; gap: 8px 16px;">
      <dt>Цена</dt>
      <dd>{{ fertilizer.price }}</dd>

      <dt>Создано</dt>
      <dd>{{ fertilizer.createdAt.toFormat('dd.MM.yyyy HH:mm') }}</dd>
    </dl>

    <div style="margin-top: 16px;">
      @!link({ route: 'fertilizers.edit', routeParams: { id: fertilizer.id }, text: 'Редактировать' })
      @!link({ route: 'fertilizers.index', text: 'Назад к списку' })
    </div>

    <div style="margin-top: 16px;">
      @form({ route: 'fertilizers.destroy', routeParams: { id: fertilizer.id }, method: 'DELETE' })
        @!button({ text: 'Удалить', type: 'submit' })
      @end
    </div>
  </div>
@end
