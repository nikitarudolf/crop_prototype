@layout()
  <h1>Удобрения</h1>

  <div style="margin: 16px 0;">
    @!link({ route: 'fertilizers.create', text: 'Добавить удобрение' })
  </div>

  @if(fertilizers.length)
    <table style="width: 100%; border-collapse: collapse;">
      <thead>
        <tr>
          <th style="text-align: left; padding: 8px 0; border-bottom: 1px solid #e5e5e5;">ID</th>
          <th style="text-align: left; padding: 8px 0; border-bottom: 1px solid #e5e5e5;">Название</th>
          <th style="text-align: left; padding: 8px 0; border-bottom: 1px solid #e5e5e5;">Цена</th>
          <th style="text-align: left; padding: 8px 0; border-bottom: 1px solid #e5e5e5;">Действия</th>
        </tr>
      </thead>
      <tbody>
        @each(fertilizer in fertilizers)
          <tr>
            <td style="padding: 10px 0; border-bottom: 1px solid #f0f0f0;">{{ fertilizer.id }}</td>
            <td style="padding: 10px 0; border-bottom: 1px solid #f0f0f0;">{{ fertilizer.name }}</td>
            <td style="padding: 10px 0; border-bottom: 1px solid #f0f0f0;">{{ fertilizer.price }}</td>
            <td>
              @!link({ route: 'fertilizers.show', routeParams: { id: fertilizer.id }, text: 'Открыть' })
              @!link({ route: 'fertilizers.edit', routeParams: { id: fertilizer.id }, text: 'Редактировать' })
            </td>
          </tr>
        @end
      </tbody>
    </table>
  @else
    <p>Удобрений пока нет.</p>
  @end
@end
