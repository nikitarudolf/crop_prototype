@layout({ title: 'Удобрения' })
  <div class="page-header">
    <h1>Удобрения</h1>
    @!link({
      route: 'fertilizers.create',
      text: 'Добавить удобрение',
      variant: 'primary',
    })
  </div>
  @if(fertilizers.length)
    <div class="table-wrap">
      <table class="data">
        <thead>
          <tr>
            <th>ID</th>
            <th>Название</th>
            <th>Цена, Br/кг</th>
            <th>Действия</th>
          </tr>
        </thead>
        <tbody>
          @each(fertilizer in fertilizers)
            <tr>
              <td>{{ fertilizer.id }}</td>
              <td>{{ fertilizer.name }}</td>
              <td>{{ fertilizer.price }}</td>
              <td>
                <div class="row-actions">
                  @!link({
                    route: 'fertilizers.show',
                    routeParams: { id: fertilizer.id },
                    text: 'Открыть',
                  })
                  @!link({
                    route: 'fertilizers.edit',
                    routeParams: { id: fertilizer.id },
                    text: 'Изменить',
                  })
                </div>
              </td>
            </tr>
          @end
        </tbody>
      </table>
    </div>
  @else
    <p class="empty">Удобрений пока нет.</p>
  @end
@end
