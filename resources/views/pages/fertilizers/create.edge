@layout({ title: 'Добавить удобрение' })
  <div class="form-page">
    <div class="page-header">
      <h1>Добавить удобрение</h1>
    </div>
    @form({ route: 'fertilizers.store', method: 'POST' })
      <div class="form-stack">
        @field.root({ name: 'name' })
          @!field.label({ text: 'Название' })
          @!input.control()
          @!field.error()
        @end
        @field.root({ name: 'price' })
          @!field.label({ text: 'Цена (Br/кг)' })
          @!input.control({ type: 'number', step: '0.01', min: '0.01' })
          @!field.error()
        @end

        <div class="actions">
          @!button({ text: 'Создать', type: 'submit' })
          @!link({ route: 'fertilizers.index', text: 'Отмена', variant: 'secondary' })
        </div>
      </div>
    @end
  </div>
@end
