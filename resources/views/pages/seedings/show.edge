@layout({ title: 'Посев: ' + seeding.crop.name })
  <div class="page-header">
    <div>
      <h1>Посев: {{ seeding.crop.name }}</h1>
      <p class="lead">{{ seeding.field.displayName }} ({{ seeding.field.area }} га)</p>
    </div>
    @if(seeding.status === SEEDING_STATUS.ACTIVE)
      <span class="badge badge-ok">Активный</span>
    @else
      <span class="badge">Завершён</span>
    @end
  </div>

  <div class="panel">
    <div class="stats">
      <div>
        <span class="stat-label">Дата начала</span>
        <p class="stat-value">{{ seeding.startedAt.toFormat('dd.MM.yyyy') }}</p>
      </div>
      <div>
        <span class="stat-label">Ожидаемый урожай</span>
        <p class="stat-value">{{ expectedTons === null ? '—' : expectedTons + ' т' }}</p>
      </div>
      <div>
        <span class="stat-label">Себестоимость</span>
        <p class="stat-value">{{ money(seeding.cost) }}</p>
      </div>
      <div>
        <span class="stat-label">Вероятность</span>
        <p class="stat-value">{{ probabilityLabel(seeding.probability) }}</p>
      </div>
    </div>
    @if(seeding.seedCost !== null && seeding.fertilizerCost !== null)
      <p class="muted">
        
        Семена:
        {{ money(seeding.seedCost) }}
         · Удобрения:
        {{ money(seeding.fertilizerCost) }}
        @if(seeding.expectedYieldPerHa !== null)
          · Ожидаемая урожайность:
          {{ seeding.expectedYieldPerHa }}
          т/га
        @end
      </p>
    @end
  </div>

  <div class="panel">
    <h2>Внесённые удобрения по стадиям</h2>
    @if(seeding.seedingFertilizers.length)
      <div class="list-plain">
        @each(item in seeding.seedingFertilizers)
          <div>
            <span><strong>{{ item.stageName }}</strong>: {{ item.fertilizer.name }}</span>
            <span>{{ item.dosageUsed }} кг/га</span>
          </div>
        @end
      </div>
    @else
      <p class="muted">Без удобрений</p>
    @end
  </div>
  @if(seeding.status === SEEDING_STATUS.ACTIVE)
    <div class="notice">
      <h2>Уборка урожая и завершение</h2>
      @form({
        route: 'seedings.complete',
        routeParams: { id: seeding.id },
        method: 'POST',
      })
        <div class="form-stack">
          @field.root({ name: 'actualYieldPerHa' })
            @!field.label({ text: 'Фактический урожай (т/га)' })
            @!input.control({
              type: 'number',
              step: '0.01',
              min: '0',
              placeholder: 'Например: 3.5',
              required: true,
            })
            @!field.error()
          @end

          <div class="actions">
            @!button({ text: 'Завершить посев', type: 'submit' })
          </div>
        </div>
      @end
    </div>
  @else
    <div class="panel">
      <h2>Итоги уборки</h2>
      <dl class="dl">
        <dt>Дата завершения</dt>
        <dd>{{ seeding.finishedAt?.toFormat('dd.MM.yyyy') }}</dd>
        <dt>Ожидаемый урожай</dt>
        <dd>
          {{ seeding.expectedYieldPerHa === null ? '—' : seeding.expectedYieldPerHa + ' т/га' }}{{ expectedTons === null ? '' : ' (' + expectedTons + ' т)' }}
        </dd>
        <dt>Фактический урожай</dt>
        <dd>
          {{ seeding.actualYieldPerHa }}
          т/га{{ actualTons === null ? '' : ' (' + actualTons + ' т)' }}
        </dd>
      </dl>
    </div>
  @end
@end
