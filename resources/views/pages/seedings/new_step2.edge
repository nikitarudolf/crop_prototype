@let(title = 'Создание посева — Шаг 2: План удобрений')

@component('components/layout', { title })
  <div class="max-w-4xl mx-auto py-6 px-4">
    <div class="mb-6">
      <h1 class="text-2xl font-bold text-gray-900">План удобрений для {{ crop.name }}</h1>
      <p class="text-sm text-gray-600">Поле: Поле №{{ field.id }} ({{ field.area }} га)</p>
    </div>

    {{-- Прогресс-бар --}}
    <div class="flex items-center mb-8 border-b pb-4">
      <div class="flex items-center text-green-600">
        <span class="w-8 h-8 rounded-full bg-green-100 flex items-center justify-center mr-2">✓</span>
        Культура
      </div>
      <div class="h-0.5 w-12 bg-green-600 mx-4"></div>
      <div class="flex items-center text-green-600 font-semibold">
        <span class="w-8 h-8 rounded-full bg-green-100 flex items-center justify-center mr-2">2</span>
        Удобрения
      </div>
      <div class="h-0.5 w-12 bg-gray-200 mx-4"></div>
      <div class="flex items-center text-gray-400">
        <span class="w-8 h-8 rounded-full bg-gray-100 flex items-center justify-center mr-2">3</span>
        Итог
      </div>
    </div>

    <form method="POST" action="{{ route('seedings.new.step3', { fieldId: field.id }) }}">
      {{ csrfField() }}
      <input type="hidden" name="cropId" value="{{ crop.id }}" />

      <div id="stages-container" class="space-y-4 mb-6">
        @each((stage, index) in plan)
          <div class="stage-row border p-4 rounded-lg bg-white shadow-sm flex flex-col md:flex-row gap-4 items-end">
            <div class="flex-1 w-full">
              <label class="block text-xs font-semibold text-gray-700 uppercase mb-1">Стадия</label>
              <input 
                type="text" 
                name="stageName" 
                value="{{ stage.stageName }}" 
                required 
                class="w-full border rounded-md p-2 text-sm"
              />
            </div>

            <div class="flex-1 w-full">
              <label class="block text-xs font-semibold text-gray-700 uppercase mb-1">Удобрение</label>
              <select name="fertilizerId" required class="w-full border rounded-md p-2 text-sm">
                @each(fertilizer in allFertilizers)
                  <option 
                    value="{{ fertilizer.id }}" 
                    {{ fertilizer.id === stage.fertilizer.id ? 'selected' : '' }}
                  >
                    {{ fertilizer.name }} ({{ fertilizer.price }} ₽/кг)
                  </option>
                @end
              </select>
            </div>

            <div class="w-full md:w-32">
              <label class="block text-xs font-semibold text-gray-700 uppercase mb-1">Доза (кг/га)</label>
              <input 
                type="number" 
                step="0.1" 
                name="dosage" 
                value="{{ stage.dosagePerHa }}" 
                required 
                class="w-full border rounded-md p-2 text-sm"
              />
            </div>
          </div>
        @end
      </div>

      <div class="flex justify-between items-center border-t pt-4">
        <a href="{{ route('seedings.new.step1', { fieldId: field.id }) }}" class="text-gray-600 hover:underline">
          &larr; Назад
        </a>
        <button type="submit" class="px-5 py-2 bg-green-600 text-white rounded-md hover:bg-green-700 font-medium">
          Далее: Расчёт себестоимости &rarr;
        </button>
      </div>
    </form>
  </div>
@end