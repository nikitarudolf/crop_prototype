@let(oldStageNames = old('stageName', []))
@let(oldFertilizerIds = old('fertilizerId', []))
@let(oldDosages = old('dosage', []))
@let(rows = oldStageNames.length
  ? oldStageNames.map((stageName, i) => ({
      stageName,
      fertilizerId: oldFertilizerIds[i],
      dosage: oldDosages[i],
    }))
  : plan.map((item) => ({
      stageName: item.stageName,
      fertilizerId: String(item.fertilizer.id),
      dosage: item.dosagePerHa,
    })))
@let(errorMessages = Object.values(flashMessages.get('inputErrorsBag', {})).flat())

@layout({ title: 'Новый посев — удобрения' })
  <div class="page-header">
    <div>
      <h1>{{ field.displayName }}</h1>
      <p class="lead">Культура: {{ crop.name }}</p>
    </div>
  </div>

  <div class="steps">
    <span class="step is-done">1. Культура</span>
    <span class="step is-current">2. Удобрения</span>
    <span class="step">3. Итог</span>
  </div>

  @if(errorMessages.length)
    <div class="notice">
      @each(message in errorMessages)
        <p>{{ message }}</p>
      @end
    </div>
  @end

  @if(plan.length === 0 && !oldStageNames.length)
    <div class="notice">
      <p>Для культуры «{{ crop.name }}» нет готового плана удобрений. Стадии можно не добавлять — план останется пустым.</p>
    </div>
  @end

  <div class="panel">
    @form({ route: 'seedings.new.step3', routeParams: { fieldId: field.id }, method: 'POST' })
      <input type="hidden" name="cropId" value="{{ crop.id }}" />

      <div class="form-stack">
        @each((row, index) in rows)
          <div class="stage-row">
            <div>
              <label for="stageName-{{ index }}">Стадия</label>
              <input
                type="text"
                id="stageName-{{ index }}"
                name="stageName"
                value="{{ row.stageName }}"
                required
              />
            </div>

            <div>
              <label for="fertilizerId-{{ index }}">Удобрение</label>
              <select id="fertilizerId-{{ index }}" name="fertilizerId" required>
                @each(fertilizer in allFertilizers)
                  <option
                    value="{{ fertilizer.id }}"
                    {{ String(fertilizer.id) === row.fertilizerId ? 'selected' : '' }}
                  >
                    {{ fertilizer.name }} ({{ fertilizer.price }} ₽/кг)
                  </option>
                @end
              </select>
            </div>

            <div class="stage-dose">
              <label for="dosage-{{ index }}">Доза (кг/га)</label>
              <input
                type="number"
                step="0.1"
                min="0.1"
                id="dosage-{{ index }}"
                name="dosage"
                value="{{ row.dosage }}"
                required
              />
            </div>
          </div>
        @end

        <div class="between">
          @!link({ route: 'seedings.new.step1', routeParams: { fieldId: field.id }, text: '← Назад', variant: 'secondary' })
          @!button({ text: 'Далее: расчёт себестоимости →', type: 'submit' })
        </div>
      </div>
    @end
  </div>
@end
