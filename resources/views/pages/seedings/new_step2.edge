@layout({ title: 'Новый посев — удобрения' })
  <div class="page-header">
    <div>
      <h1>{{ field.displayName }}</h1>
      <p class="lead">Культура: {{ crop.name }} · поле {{ field.area }} га</p>
    </div>
  </div>
  @!wizardSteps({ current: 2 })
  @include('partials/validation_errors')
  @if(showEmptyPlanNotice)
    <div class="notice">
      <p>Готового плана нет — добавьте стадии вручную или оставьте план пустым.</p>
    </div>
  @end

  <div class="panel" x-data="stagePlan({{ JSON.stringify(stagePlanConfig) }})">
    @form({
      route: 'seedings.new.step3',
      routeParams: { fieldId: field.id },
      method: 'POST',
    })
      <input type="hidden" name="cropId" value="{{ crop.id }}" />
      @if(desiredYieldTons)
        <input type="hidden" name="desiredYieldTons" value="{{ desiredYieldTons }}" />
      @end

      <div class="form-stack">
        <div class="sown-area">
          <div>
            <label for="sownArea">Площадь посева (га)</label>
            <input
              type="number"
              step="0.01"
              min="0.01"
              max="{{ field.area }}"
              id="sownArea"
              name="sownArea"
              x-model="area"
              required
            />
          </div>
          <p class="muted">
            Из
            {{ field.area }}
            га поля.
            <span x-show="isPartial">Остальное останется незасеянным.</span>
            Ожидаемый урожай:
            <strong x-text="expectedTons.toFixed(2) + ' т'"></strong>
          </p>
        </div>

        <template x-for="(row, index) in rows" :key="row.uid">
          <div class="stage-row">
            <div>
              <label :for="'stageName-' + row.uid">Стадия</label>
              <input
                type="text"
                :id="'stageName-' + row.uid"
                :name="'stages[' + index + '][stageName]'"
                x-model="row.stageName"
                required
              />
            </div>

            <div>
              <label :for="'fertilizerId-' + row.uid">Удобрение</label>
              <select
                :id="'fertilizerId-' + row.uid"
                :name="'stages[' + index + '][fertilizerId]'"
                x-model="row.fertilizerId"
                required
              >
                @each(fertilizer in allFertilizers)
                  <option value="{{ fertilizer.id }}">
                    {{ fertilizer.name }}
                    ({{ fertilizer.price }}
                    Br/кг)
                  </option>
                @end
              </select>
            </div>

            <div class="stage-dose">
              <label :for="'dosage-' + row.uid">Доза (кг/га)</label>
              <input
                type="number"
                step="0.1"
                min="0.1"
                :id="'dosage-' + row.uid"
                :name="'stages[' + index + '][dosagePerHa]'"
                x-model="row.dosagePerHa"
                required
              />
            </div>

            <span class="stage-cost" x-text="money(rowCost(row))"></span>

            <button type="button" class="btn btn-ghost" @click="removeRow(index)">✕</button>
          </div>
        </template>

        <div>
          @!button({
            text: '+ Добавить стадию',
            type: 'button',
            variant: 'secondary',
            '@click': 'addRow()',
          })
        </div>

        <div class="between">
          @!link({
            href: backUrl,
            text: '← Назад',
            variant: 'secondary',
          })
          @!button({ text: 'Далее: расчёт себестоимости →', type: 'submit' })
        </div>
      </div>
    @end

    <div class="panel stage-summary">
      <div class="stats">
        <div>
          <span class="stat-label">Семена</span>
          <p class="stat-value" x-text="money(seedCost)"></p>
        </div>
        <div>
          <span class="stat-label">Удобрения</span>
          <p class="stat-value" x-text="money(fertilizerCost)"></p>
        </div>
        <div>
          <span class="stat-label">Итого</span>
          <p class="stat-value" x-text="money(totalCost)"></p>
        </div>
        <div>
          <span class="stat-label">На гектар</span>
          <p class="stat-value" x-text="money(costPerHa)"></p>
        </div>
        <div>
          <span class="stat-label">На тонну</span>
          <p class="stat-value" x-text="money(costPerExpectedTon)"></p>
        </div>
      </div>
    </div>
  </div>
@end
