@layout({ title: 'Посевы' })
  <div class="page-header">
    <h1>Посевы</h1>
    <div class="tabs">
      <a
        href="{{
          route(
            'seedings.index',
            {},
            { qs: { status: SEEDING_STATUS.ACTIVE } },
          )
        }}"
        class="tab {{ currentStatus === SEEDING_STATUS.ACTIVE ? 'is-active' : '' }}"
      >
        Активные
      </a>
      <a
        href="{{
          route(
            'seedings.index',
            {},
            { qs: { status: SEEDING_STATUS.COMPLETED } },
          )
        }}"
        class="tab {{ currentStatus === SEEDING_STATUS.COMPLETED ? 'is-active' : '' }}"
      >
        Завершённые
      </a>
    </div>
  </div>
  @if(seedings.length)
    <div class="table-wrap">
      <table class="data">
        <thead>
          <tr>
            <th>Поле</th>
            <th>Культура</th>
            <th>Дата старта</th>
            <th>Себестоимость</th>
            <th>Урожай, т/га</th>
            <th>Действие</th>
          </tr>
        </thead>
        <tbody>
          @each(seeding in seedings)
            <tr>
              <td>{{ seeding.field.displayName }}</td>
              <td>{{ seeding.crop.name }}</td>
              <td>{{ seeding.startedAt.toFormat('dd.MM.yyyy') }}</td>
              <td>
                {{ money(seeding.cost) }}
                @if(seeding.seedCost !== null && seeding.fertilizerCost !== null)
                  <p class="muted">
                    семена
                    {{ money(seeding.seedCost) }}
                    · удобрения
                    {{ money(seeding.fertilizerCost) }}
                  </p>
                @end
              </td>
              <td>
                план
                {{ seeding.expectedYieldPerHa === null ? '—' : seeding.expectedYieldPerHa }}
                / факт
                {{ seeding.actualYieldPerHa === null ? '—' : seeding.actualYieldPerHa }}
              </td>
              <td>
                @!link({
                  route: 'seedings.show',
                  routeParams: { id: seeding.id },
                  text: 'Открыть',
                })
              </td>
            </tr>
          @end
        </tbody>
      </table>
    </div>
  @else
    <p class="empty">Записи не найдены</p>
  @end
@end
