@layout({ title: 'Посевы' })
  <div class="page-header">
    <h1>Посевы</h1>
    <div class="tabs">
      <a
        href="{{
          route(
            'seedings.index',
            {},
            { qs: { status: SEEDING_STATUS.ACTIVE } },
          )
        }}"
        class="tab {{ currentStatus === SEEDING_STATUS.ACTIVE ? 'is-active' : '' }}"
      >
        Активные
      </a>
      <a
        href="{{
          route(
            'seedings.index',
            {},
            { qs: { status: SEEDING_STATUS.COMPLETED } },
          )
        }}"
        class="tab {{ currentStatus === SEEDING_STATUS.COMPLETED ? 'is-active' : '' }}"
      >
        Завершённые
      </a>
    </div>
  </div>
  @!seedingsTable({
    seedings: seedings,
    showField: true,
    empty: 'Записи не найдены',
  })
@end
