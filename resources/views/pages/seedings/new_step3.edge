@let(errorMessages = Object.values(flashMessages.get('inputErrorsBag', {})).flat())
@layout({ title: 'Новый посев — подтверждение' })
  <div class="page-header">
    <div>
      <h1>{{ field.displayName }}</h1>
      <p class="lead">Проверьте данные перед сохранением</p>
    </div>
  </div>

  <div class="steps">
    <span class="step is-done">1. Культура</span>
    <span class="step is-done">2. Удобрения</span>
    <span class="step is-current">3. Итог</span>
  </div>
  @if(errorMessages.length)
    <div class="notice">
      @each(message in errorMessages)
        <p>{{ message }}</p>
      @end
    </div>
  @end
  @form({ route: 'seedings.store', routeParams: { fieldId: field.id }, method: 'POST' })
    <input type="hidden" name="cropId" value="{{ crop.id }}" />
    @each((item, index) in cost.stages)
      <input type="hidden" name="stages[{{ index }}][stageName]" value="{{ item.stageName }}" />
      <input
        type="hidden"
        name="stages[{{ index }}][fertilizerId]"
        value="{{ item.fertilizer.id }}"
      />
      <input type="hidden" name="stages[{{ index }}][dosagePerHa]" value="{{ item.dosagePerHa }}" />
    @end

    <div class="panel">
      <dl class="dl">
        <dt>Поле</dt>
        <dd>{{ field.displayName }} ({{ field.area }} га)</dd>
        <dt>Культура</dt>
        <dd>{{ crop.name }}</dd>
      </dl>
    </div>

    <div class="panel">
      <h2>План удобрений</h2>
      @if(cost.stages.length)
        <div class="list-plain">
          @each(item in cost.stages)
            <div>
              <span><strong>{{ item.stageName }}</strong>: {{ item.fertilizer.name }}</span>
              <span>{{ item.dosagePerHa }} кг/га · {{ money(item.cost) }}</span>
            </div>
          @end
        </div>
      @else
        <p class="muted">Без удобрений</p>
      @end
    </div>

    <div class="panel">
      <div class="stats">
        <div>
          <span class="stat-label">Ожидаемый урожай</span>
          <p class="stat-value">{{ cost.expectedTons }} т</p>
        </div>
        <div>
          <span class="stat-label">Себестоимость</span>
          <p class="stat-value">{{ money(cost.totalCost) }}</p>
        </div>
        <div>
          <span class="stat-label">На гектар</span>
          <p class="stat-value">{{ money(cost.costPerHa) }}</p>
        </div>
        <div>
          <span class="stat-label">На тонну</span>
          <p class="stat-value">{{ money(cost.costPerExpectedTon) }}</p>
        </div>
      </div>
      <p class="muted">
        Семена:
        {{ money(cost.seedCost) }}
        · Удобрения:
        {{ money(cost.fertilizerCost) }}
      </p>
    </div>
    @if(probability === 'low')
      <div class="notice">
        <p>Вероятность низкая: {{ probabilityReason }}</p>
      </div>
    @else
      <p class="muted">Вероятность высокая: {{ probabilityReason }}</p>
    @end

    <div class="between">
      @!button({
        text: '← Изменить удобрения',
        type: 'submit',
        variant: 'secondary',
        formaction: urlFor('seedings.new.step2.back', { fieldId: field.id }),
      })
      @!button({ text: 'Подтвердить и засеять', type: 'submit' })
    </div>
  @end
@end
