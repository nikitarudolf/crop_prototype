@let(errorMessages = Object.values(flashMessages.get('inputErrorsBag', {})).flat())

@layout({ title: 'Новый посев — подтверждение' })
  <div class="page-header">
    <div>
      <h1>{{ field.displayName }}</h1>
      <p class="lead">Проверьте данные перед сохранением</p>
    </div>
  </div>

  <div class="steps">
    <span class="step is-done">1. Культура</span>
    <span class="step is-done">2. Удобрения</span>
    <span class="step is-current">3. Итог</span>
  </div>

  @if(errorMessages.length)
    <div class="notice">
      @each(message in errorMessages)
        <p>{{ message }}</p>
      @end
    </div>
  @end

  @form({ route: 'seedings.store', routeParams: { fieldId: field.id }, method: 'POST' })
    <input type="hidden" name="cropId" value="{{ crop.id }}" />
    @each(item in fertilizerPlan)
      <input type="hidden" name="stageName" value="{{ item.stageName }}" />
      <input type="hidden" name="fertilizerId" value="{{ item.fertilizer.id }}" />
      <input type="hidden" name="dosage" value="{{ item.dosagePerHa }}" />
    @end

    <div class="panel">
      <dl class="dl">
        <dt>Поле</dt>
        <dd>{{ field.displayName }} ({{ field.area }} га)</dd>
        <dt>Культура</dt>
        <dd>{{ crop.name }}</dd>
      </dl>
    </div>

    <div class="panel">
      <h2>План удобрений</h2>
      @if(fertilizerPlan.length)
        <div class="list-plain">
          @each(item in fertilizerPlan)
            <div>
              <span><strong>{{ item.stageName }}</strong>: {{ item.fertilizer.name }}</span>
              <span>{{ item.dosagePerHa }} кг/га</span>
            </div>
          @end
        </div>
      @else
        <p class="muted">Без удобрений</p>
      @end
    </div>

    <div class="panel">
      <div class="stats">
        <div>
          <span class="stat-label">Вероятность успеха</span>
          <p class="stat-value">{{ probabilityText }}</p>
        </div>
        <div>
          <span class="stat-label">Себестоимость</span>
          <p class="stat-value">{{ cost.totalCost.toLocaleString() }} ₽</p>
        </div>
      </div>
      <p class="muted">Семена: {{ cost.seedCost.toLocaleString() }} ₽ · Удобрения: {{ cost.fertilizerCost.toLocaleString() }} ₽</p>
    </div>

    <div class="between">
      @!button({ text: '← Изменить удобрения', type: 'button', variant: 'secondary', onclick: 'history.back()' })
      @!button({ text: 'Подтвердить и засеять', type: 'submit' })
    </div>
  @end
@end
