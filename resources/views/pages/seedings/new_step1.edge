@layout({ title: 'Новый посев — культура' })
  <div class="page-header">
    <div>
      <h1>{{ field.displayName }}</h1>
      <p class="lead">Площадь: {{ field.area }} га · Тип почвы: {{ field.type }}</p>
    </div>
  </div>

  <div class="steps">
    <span class="step is-current">1. Культура</span>
    <span class="step">2. Удобрения</span>
    <span class="step">3. Итог</span>
  </div>

  @form({ route: 'seedings.new.step2', routeParams: { fieldId: field.id }, method: 'GET' })
    <div class="choice-list">
      @each(item in recommendations)
        <label class="choice">
          <div class="choice-inner">
            <div class="choice-main">
              <input type="radio" name="cropId" value="{{ item.crop.id }}" required />
              <div>
                <span>{{ item.crop.name }}</span>
                <p class="muted">
                  Урожайность: {{ item.crop.avgYieldPerHa }} т/га · Семена: {{ item.crop.price }} ₽/га
                </p>
              </div>
            </div>

            @if(item.suitability === 'recommended')
              <span class="badge badge-ok">Рекомендуется</span>
            @else
              <span class="badge badge-warn">Не рекомендуется</span>
            @end
          </div>
        </label>
      @end
    </div>

    <div class="between">
      @!link({ route: 'fields.show', routeParams: { id: field.id }, text: 'Отмена', variant: 'secondary' })
      @!button({ text: 'Далее: удобрения →', type: 'submit' })
    </div>
  @end
@end
