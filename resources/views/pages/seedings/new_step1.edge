@layout({ title: 'Новый посев — культура' })
  <div class="page-header">
    <div>
      <h1>{{ field.displayName }}</h1>
      <p class="lead">Площадь: {{ field.area }} га · Тип почвы: {{ fieldTypeLabel[field.type] }}</p>
    </div>
  </div>
  @!wizardSteps({ current: 1 })
  @form({
    route: 'seedings.new.step2',
    routeParams: { fieldId: field.id },
    method: 'GET',
  })
    @field.root({ name: 'cropId' })
      <div class="choice-list">
        @each(item in recommendations)
          <label class="choice">
            <div class="choice-inner">
              <div class="choice-main">
                <input
                  type="radio"
                  name="cropId"
                  value="{{ item.crop.id }}"
                  {{
                    selectedCropId && String(item.crop.id) === String(selectedCropId)
                      ? 'checked'
                      : ''
                  }}
                  required
                />
                <div>
                  <span>{{ item.crop.name }}</span>
                  <p class="muted">
                    Семена:
                    {{ money(item.cost.seedCost) }}
                    на поле ({{ money(item.crop.price) }}/га) · Ожидаемый урожай:
                    {{ item.cost.expectedTons }}
                    т ({{ item.crop.avgYieldPerHa }}
                    ц/га)
                  </p>
                </div>
              </div>

              <div>
                @if(item.probability === PROBABILITY_LABEL.HIGH)
                  <span class="badge badge-ok">Рекомендуется</span>
                @elseif(item.probability === PROBABILITY_LABEL.MEDIUM)
                  <span class="badge">С оговорками</span>
                @else
                  <span class="badge badge-warn">Не рекомендуется</span>
                @end

                <p class="muted">{{ item.reason }}</p>
              </div>
            </div>
          </label>
        @end
      </div>
      @!field.error()
    @end

    <p class="muted">Указана только стоимость семян. Удобрения добавятся на следующем шаге.</p>

    <div class="between">
      @!link({
        route: 'fields.show',
        routeParams: { id: field.id },
        text: 'Отмена',
        variant: 'secondary',
      })
      @!button({ text: 'Далее: удобрения →', type: 'submit' })
    </div>
  @end
@end
