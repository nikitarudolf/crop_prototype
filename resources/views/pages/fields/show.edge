@layout()
  <h1>Поле #{{ field.id }}</h1>

  <div style="margin: 16px 0;">
    <dl style="display: grid; grid-template-columns: 200px 1fr; gap: 8px 16px;">
      <dt>Площадь</dt>
      <dd>{{ field.area }} га</dd>

      <dt>Тип почвы</dt>
      <dd>{{ field.type }}</dd>

      <dt>Статус</dt>
      <dd>
        @if(field.status === FIELD_STATUS.FREE)
          Свободно
        @else
          Занято
        @end
      </dd>

      <dt>Создано</dt>
      <dd>{{ field.createdAt.toFormat('dd.MM.yyyy HH:mm') }}</dd>
    </dl>

    <div style="margin-top: 16px;">
      @if(field.status === FIELD_STATUS.FREE)
        @!link({ route: 'seedings.new.step1', routeParams: { fieldId: field.id }, text: 'Начать посев' })
      @else
        <p>Поле занято активным посевом</p>
        @if(activeSeeding)
          @!link({ route: 'seedings.show', routeParams: { id: activeSeeding.id }, text: 'Перейти к посеву' })
        @end
      @end
    </div>

    <div style="margin-top: 16px;">
      @!link({ route: 'fields.edit', routeParams: { id: field.id }, text: 'Редактировать' })
      @!link({ route: 'fields.index', text: 'Назад к списку' })
    </div>

    <div style="margin-top: 16px;">
      @form({ route: 'fields.destroy', routeParams: { id: field.id }, method: 'DELETE' })
        @!button({ text: 'Удалить', type: 'submit' })
      @end
    </div>
  </div>
@end
