@layout()
  <div class="form-container">
    <div>
      <h1>Редактировать поле #{{ field.id }}</h1>

      @form({ route: 'fields.update', routeParams: { id: field.id }, method: 'PUT' })
        <div>
          @field.root({ name: 'area' })
            @!field.label({ text: 'Площадь (га)' })
            @!input.control({ type: 'number', step: '0.01', min: '0.01', value: field.area })
            @!field.error()
          @end
        </div>

        <div>
          @field.root({ name: 'type' })
            @!field.label({ text: 'Тип почвы' })
            @!select.control({
              options: fieldTypes.map((t) => ({
                value: t,
                name: t,
                // Чтобы при ошибке валидации пользователь не терял выбор,
                // isSelected отключаем, если есть old-значение.
                isSelected: !old('type') && t === field.type,
              }))
            })
            @!field.error()
          @end
        </div>

        <div>
          @!button({ text: 'Сохранить', type: 'submit' })
        </div>
      @end

      <div style="margin-top: 16px;">
        @!link({ route: 'fields.show', routeParams: { id: field.id }, text: 'Назад к полю' })
      </div>
    </div>
  </div>
@end
