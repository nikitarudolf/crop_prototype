@layout({ title: 'Поля' })
  <div class="page-header">
    <h1>Поля</h1>
    @!link({ route: 'fields.create', text: 'Добавить поле', variant: 'primary' })
  </div>
  @if(fields.length)
    <div class="table-wrap">
      <table class="data">
        <thead>
          <tr>
            <th>Поле</th>
            <th>Площадь (га)</th>
            <th>Тип</th>
            <th>Статус</th>
            <th>Действия</th>
          </tr>
        </thead>
        <tbody>
          @each(field in fields)
            <tr>
              <td>{{ field.displayName }}</td>
              <td>{{ field.area }}</td>
              <td>{{ fieldTypeLabel[field.type] }}</td>
              <td>
                @if(field.status === FIELD_STATUS.FREE)
                  <span class="badge badge-ok">Свободно</span>
                @else
                  <span class="badge">Занято</span>
                @end
              </td>
              <td>
                <div class="row-actions">
                  @!link({
                    route: 'fields.show',
                    routeParams: { id: field.id },
                    text: 'Открыть',
                  })
                  @!link({
                    route: 'fields.edit',
                    routeParams: { id: field.id },
                    text: 'Изменить',
                  })
                </div>
              </td>
            </tr>
          @end
        </tbody>
      </table>
    </div>
  @else
    <p class="empty">Полей пока нет.</p>
  @end
@end
