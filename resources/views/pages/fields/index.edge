@layout()
  <h1>Поля</h1>

  <div style="margin: 16px 0;">
    @!link({ route: 'fields.create', text: 'Добавить поле' })
  </div>

  @if(fields.length)
    <table style="width: 100%; border-collapse: collapse;">
      <thead>
        <tr>
          <th style="text-align: left; padding: 8px 0; border-bottom: 1px solid #e5e5e5;">ID</th>
          <th style="text-align: left; padding: 8px 0; border-bottom: 1px solid #e5e5e5;">Площадь (га)</th>
          <th style="text-align: left; padding: 8px 0; border-bottom: 1px solid #e5e5e5;">Тип</th>
          <th style="text-align: left; padding: 8px 0; border-bottom: 1px solid #e5e5e5;">Статус</th>
          <th style="text-align: left; padding: 8px 0; border-bottom: 1px solid #e5e5e5;">Действия</th>
        </tr>
      </thead>
      <tbody>
        @each(field in fields)
          <tr>
            <td style="padding: 10px 0; border-bottom: 1px solid #f0f0f0;">{{ field.id }}</td>
            <td style="padding: 10px 0; border-bottom: 1px solid #f0f0f0;">{{ field.area }}</td>
            <td style="padding: 10px 0; border-bottom: 1px solid #f0f0f0;">{{ field.type }}</td>
            <td style="padding: 10px 0; border-bottom: 1px solid #f0f0f0;">{{ field.status }}</td>
            <td>
              @!link({ route: 'fields.show', routeParams: { id: field.id }, text: 'Открыть' })
              @!link({ route: 'fields.edit', routeParams: { id: field.id }, text: 'Редактировать' })
            </td>
          </tr>
        @end
      </tbody>
    </table>
  @else
    <p>Полей пока нет.</p>
  @end
@end
