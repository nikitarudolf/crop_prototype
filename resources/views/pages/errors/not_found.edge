@layout({ title: 'Страница не найдена' })
  <div class="page-header">
    <h1>404 — страница не найдена</h1>
  </div>
  <div class="stack">
    <p class="muted">Такой страницы не существует или она была перемещена.</p>
    <div class="actions">
      @!link({ route: 'home', text: 'На главную', variant: 'primary' })
    </div>
  </div>
@end
