@layout({ title: 'Ошибка сервера' })
  <div class="page-header">
    <h1>{{ error.code }} — ошибка сервера</h1>
  </div>
  <div class="stack">
    <p class="muted">Что-то пошло не так. Попробуйте обновить страницу или вернуться позже.</p>
    <div class="actions">
      @!link({ route: 'home', text: 'На главную', variant: 'primary' })
    </div>
  </div>
@end
