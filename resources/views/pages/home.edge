@layout({ title: 'Главная' })
  <div class="home-intro">
    <h1>Учёт посевов</h1>
    <p class="lead">Поля, справочники культур и удобрений, посевы.</p>
  </div>

  <div class="home-grid">
    @link({ route: 'fields.index', class: 'home-card' })
      <h2>Поля</h2>
      <p>Площадь, тип почвы и занятость.</p>
    @end
    @link({ route: 'crops.index', class: 'home-card' })
      <h2>Культуры</h2>
      <p>Справочник культур и урожайности.</p>
    @end
    @link({ route: 'fertilizers.index', class: 'home-card' })
      <h2>Удобрения</h2>
      <p>Справочник удобрений и цен.</p>
    @end
    @link({ route: 'seedings.index', class: 'home-card' })
      <h2>Посевы</h2>
      <p>Активные и завершённые посевы.</p>
    @end
  </div>
@end
