<header class="site-header">
  <div class="site-header-inner">
    @!link({ route: 'home', text: 'ByCrop', class: 'brand' })
    <nav class="site-nav">
      @if(auth && auth.user)
        @!link({ route: 'fields.index', text: 'Поля' })
        @!link({ route: 'crops.index', text: 'Культуры' })
        @!link({ route: 'fertilizers.index', text: 'Удобрения' })
        @!link({ route: 'seedings.index', text: 'Посевы' })
      @end
      <div class="site-nav-auth">
        @if(auth && auth.user)
          @!avatar({ initials: auth.user.initials })
          @form({ route: 'session.destroy', method: 'POST', class: 'form-inline' })
            @!button({ text: 'Выйти', variant: 'ghost', type: 'submit' })
          @end
        @else
          @!link({ route: 'new_account.create', text: 'Регистрация' })
          @!link({ route: 'session.create', text: 'Войти' })
        @end
      </div>
    </nav>
  </div>
</header>
